<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:pages="clr-namespace:App.Pages"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="App.AppShell"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent ContentTemplate="{DataTemplate pages:CrownEggPage}"
                      Icon="crown.png"
                      Route="CrownEggPage"
                      Title="Reis e Ovos" />

        <ShellContent ContentTemplate="{DataTemplate pages:CrownEggListPage}"
                      Icon="list.png"
                      Route="CrownEggListPage"
                      Title="Lista" />

        <ShellContent ContentTemplate="{DataTemplate pages:MatchesListPage}"
                      Icon="egg.png"
                      Route="MatchesListPage"
                      Title="Partidas" />
    </TabBar>

    <ShellContent ContentTemplate="{DataTemplate pages:ConfigPage}"
                  Route="ConfigPage"
                  Title="Configurações" />

</Shell>
