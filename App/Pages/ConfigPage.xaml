<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:viewmodels="clr-namespace:App.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.Pages.ConfigPage"
             x:DataType="viewmodels:ConfigViewModel"
             Title="Configurações">

    <Grid ColumnSpacing="10"
          Margin="10"
          RowSpacing="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                Padding="10">

            <Grid ColumnSpacing="10"
                  RowSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label FontAttributes="Bold"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Grid.Row="0"
                       VerticalOptions="Center"
                       Text="Informações de login" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Margin="0,0,10,0"
                       VerticalOptions="Center"
                       Text="E-mail" />

                <Entry Grid.Column="1"
                       Grid.Row="1"
                       Placeholder="e-mail"
                       VerticalOptions="Center"
                       Text="{Binding Email}" />

                <Label Grid.Column="0"
                       Grid.Row="2"
                       Margin="0,0,10,0"
                       VerticalOptions="Center"
                       Text="Senha" />

                <Entry Grid.Column="1"
                       Grid.Row="2"
                       IsPassword="True"
                       Placeholder="senha"
                       VerticalOptions="Center"
                       Text="{Binding Password}" />
            </Grid>
        </Border>

        <Border Grid.Column="0"
                Grid.Row="1"
                Padding="10">

            <Grid ColumnSpacing="10"
                  RowSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label FontAttributes="Bold"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Grid.Row="0"
                       VerticalOptions="Center"
                       Text="Informações do banco de dados" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Margin="0,0,10,0"
                       VerticalOptions="Center"
                       Text="Id da coleção" />

                <Entry Grid.Column="1"
                       Grid.Row="1"
                       Placeholder="id da coleção"
                       VerticalOptions="Center"
                       Text="{Binding CollectionId}" />
            </Grid>
        </Border>

        <Button Grid.Column="0"
                Grid.Row="2"
                VerticalOptions="End"
                Command="{Binding SaveConfigCommand}"
                IsEnabled="{Binding CanSave}"
                Text="Save" />
    </Grid>

</ContentPage>
